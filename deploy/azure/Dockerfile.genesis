# Build GenesisRK binary (CGO required for Trivy scan via hangar)
FROM golang:1.24-alpine AS go-builder
RUN apk add --no-cache build-base gpgme-dev btrfs-progs-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_LDFLAGS="-fuse-ld=bfd"
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /genesisrk .

# Build Vue frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Runtime image
FROM alpine:3.20
RUN apk add --no-cache ca-certificates gpgme
WORKDIR /app
COPY --from=go-builder /genesisrk /app/genesisrk
COPY --from=frontend-builder /app/dist /app/frontend/dist
EXPOSE 8080
ENTRYPOINT ["/app/genesisrk", "serve", "--port=8080", "--static=/app/frontend/dist"]
