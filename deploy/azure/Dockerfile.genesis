# Build GenesisRK binary (CGO required for Trivy scan via hangar)
FROM golang:1.25-alpine AS go-builder
RUN apk add --no-cache build-base gpgme-dev btrfs-progs-dev git
WORKDIR /src

# Hangar is the only first-party dependency; clone at build time for Docker/CI.
RUN git clone --depth 1 --branch v1.9.4 https://github.com/cnrancher/hangar.git /hangar

COPY go.mod go.sum ./
COPY . .
RUN sed -i 's|=> ../hangar|=> /hangar|' go.mod && go mod tidy && go mod download
ENV CGO_LDFLAGS="-fuse-ld=bfd"
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o /genesisrk .

# Build Vue frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Runtime image
FROM alpine:3.20
RUN apk add --no-cache ca-certificates gpgme
WORKDIR /app
COPY --from=go-builder /genesisrk /app/genesisrk
COPY --from=frontend-builder /app/dist /app/frontend/dist
EXPOSE 8080
ENTRYPOINT ["/app/genesisrk", "serve", "--port=8080", "--static=/app/frontend/dist"]
