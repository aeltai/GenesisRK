# Build Go binary (CGO required for containers/image -> gpgme)
FROM golang:1.24-alpine AS go-builder
RUN apk add --no-cache build-base gpgme-dev btrfs-progs-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Use bfd linker (Alpine has ld.bfd; gold may be missing on some arches)
ENV CGO_LDFLAGS="-fuse-ld=bfd"
ARG GO_BUILD_VERBOSE=
RUN CGO_ENABLED=1 go build ${GO_BUILD_VERBOSE:+-v} -ldflags="-s -w" -o /hangar .

# Build Vue frontend
FROM node:20-alpine AS frontend-builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

# Runtime image (include gpgme runtime so the binary can load; helm for
# SUSE Observability Agent chart templating — same method as SUSE air-gap docs)
FROM alpine:3.20
ARG HELM_VERSION=v3.16.4
RUN apk add --no-cache ca-certificates gpgme curl tar \
  && curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
    | tar -xz -C /tmp \
  && mv /tmp/linux-amd64/helm /usr/local/bin/helm \
  && rm -rf /tmp/linux-amd64 \
  && helm version --short
WORKDIR /app
COPY --from=go-builder /hangar /app/hangar
COPY --from=frontend-builder /app/dist /app/frontend/dist
EXPOSE 8080
ENTRYPOINT ["/app/hangar", "genesis", "serve", "--port=8080", "--static=/app/frontend/dist"]
